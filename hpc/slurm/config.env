# Configuration for running WAVES on a SLURM cluster.
# Edit this file only. All other scripts read it.
# Use absolute paths without spaces: WAVES builds shell commands from them.

# Root of the WAVES repository. The default works when this kit is in
# hpc/slurm/ of the repository. Change it if the kit is somewhere else.
WAVES_DIR="$KIT_DIR/../.."

# Large disk for environments, package caches and temporary files.
# Do not use $HOME: the environments and caches need about 20 GB.
WORK_DIR=/path/to/large/disk/waves-work

# Module that gives the `conda` command on your cluster.
# Leave empty if `conda` is already on your PATH.
CONDA_MODULE=""

# Set to 1 if loading CONDA_MODULE also loads other modules (compilers,
# ICU, OpenSSL) that break R package builds. The scripts then run
# `module purge` after conda is set up.
PURGE_MODULES_AFTER_CONDA=1

# R version for the conda environment. We tested 4.5.
R_VERSION=4.5

# Version of the R `arrow` package. Must match the version in WAVES renv.lock.
ARROW_VERSION=25.0.0

# Miniforge release for the WAVES Python environments. 00_install.sh
# compares the installer with the SHA-256 checksum of this release.
MINIFORGE_VERSION=26.9.4-2
